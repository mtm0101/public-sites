    "chatgptShared": "prompts/chatgpt/SHARED.md",
    "claudeCoworkIelts": "prompts/claude/ielts-hourly.md",
    "chatgptTasks": [
      { "id": "bbc-6min", "taskPrompt": "prompts/chatgpt/bbc-6min.md", "schedulerBaseline": "prompts/chatgpt/schedulers/bbc-6min.scheduler.md" },
      { "id": "ielts-hourly", "taskPrompt": "prompts/chatgpt/ielts-hourly.md", "schedulerBaseline": "prompts/chatgpt/schedulers/ielts-hourly.scheduler.md" },
      { "id": "daily-news", "taskPrompt": "prompts/chatgpt/daily-news.md", "schedulerBaseline": "prompts/chatgpt/schedulers/daily-news.scheduler.md" },
      { "id": "worldcup-daily", "taskPrompt": "prompts/chatgpt/worldcup-daily.md", "schedulerBaseline": "prompts/chatgpt/schedulers/worldcup-daily.scheduler.md" },
      { "id": "morning-brief", "taskPrompt": "prompts/chatgpt/morning-brief.md", "schedulerBaseline": "prompts/chatgpt/schedulers/morning-brief.scheduler.md" }
    ]
  }
