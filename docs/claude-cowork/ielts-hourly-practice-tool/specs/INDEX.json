      "appTab": "listening-test",
      "outputGlob": "data/chatgpt/dol/listening/*/questions.json",
      "manifest": "data/chatgpt/dol/listening/manifest.json"
    },
    {
      "id": "reading-test",
      "file": "specs/11-reading-test.md",
      "shape": "dol-reading-test",
      "appTab": "reading-test",
      "outputGlob": "data/chatgpt/dol/reading-test/*/questions.json",
      "manifest": "data/chatgpt/dol/reading-test/manifest.json"
    }
  ],
  "templates": {
