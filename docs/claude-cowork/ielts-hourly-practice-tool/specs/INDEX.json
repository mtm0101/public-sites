    { "order": 1, "id": "platform", "file": "specs/00-platform.md", "required": true },
    { "order": 2, "id": "task", "file": "specs/<pick-from-catalog>", "required": true },
    { "order": 3, "id": "workflows", "file": "specs/08-agent-workflows.md", "required": "when publishing" },
    { "order": 4, "id": "app", "file": "specs/07-app-features.md", "required": "when editing index.html" }
  ],
  "catalog": [
    {
      "id": "ielts-hourly-lesson",
      "file": "specs/01-ielts-hourly-lesson.md",
      "schema": 1,
      "type": "lesson",
      "category": "ielts-hourly",
      "appTab": "lessons",
      "outputGlob": "data/*/lessons/ielts-*.json",
      "skeleton": "data/templates/lesson-template.json",
      "stateFiles": ["data/claude-cowork/state.json"]
    },
    {
      "id": "bbc-6min",
      "file": "specs/02-bbc-6min.md",
      "schema": 2,
      "format": "bbc-6min",
      "type": "lesson",
      "category": "bbc-6-minute-english",
      "appTab": "bbc",
      "outputGlob": "data/*/bbc/bbc-*.json",
      "skeleton": "data/templates/bbc-lesson-template.json",
      "stateFiles": ["data/chatgpt/bbc/processed.json", "data/chatgpt/bbc/upcoming.json"]
    },
    {
      "id": "daily-news",
      "file": "specs/03-daily-news.md",
      "schema": 2,
      "type": "news",
      "category": "daily-news",
      "appTab": "others",
      "outputGlob": "data/chatgpt/news/news-gpt-*.json",
      "skeleton": "data/templates/dynamic-template.json"
    },
    {
      "id": "worldcup-briefing",
      "file": "specs/04-worldcup-briefing.md",
      "schema": 2,
      "type": "news",
      "category": "worldcup",
      "appTab": "others",
      "outputGlob": "data/chatgpt/news/worldcup-gpt-*.json",
      "skeleton": "data/templates/dynamic-template.json"
    },
    {
      "id": "morning-brief",
      "file": "specs/05-morning-brief.md",
      "schema": 2,
      "type": "brief",
      "category": "morning-brief",
      "appTab": "others",
      "outputGlob": "data/chatgpt/brief/brief-gpt-*.json",
      "language": "en-only"
    },
    {
      "id": "speaking-source",
      "file": "specs/06-speaking-source.md",
      "shape": "speaking",
      "appTab": "speaking",
      "outputGlob": "data/*/speaking/*.json",
      "reference": "data/claude-cowork/speaking/0.speaking.json"
    },
    {
      "id": "app-features",
      "file": "specs/07-app-features.md",
      "target": "index.html"
    },
    {
      "id": "agent-workflows",
      "file": "specs/08-agent-workflows.md"
    },
    {
      "id": "listening-test",
      "file": "specs/10-listening-test.md",
